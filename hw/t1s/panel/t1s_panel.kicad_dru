  (condition "(A.Reference == 'TP10' && B.Reference == 'TP11') || (A.Reference == 'TP11' && B.Reference == 'TP10') || (A.Reference == 'TP10' && B.Reference == 'TP13') || (A.Reference == 'TP13' && B.Reference == 'TP10')"))
