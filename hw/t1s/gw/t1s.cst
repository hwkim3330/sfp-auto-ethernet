// Gowin physical constraints for t1s_top on the T1S SFP board (GW5AT-LV15MG132).
// Balls from hw/t1s/make_t1s.py (FPGA = {...}); keep the two in step.
// Transceiver lane 0 (A1/A2 RX, B3/C3 TX) and REFCLK0 (A8/A7) are fixed
// pins of the hard block and are set in the Customized PHY IP, not here.
// Banks 1..4 all run at 3.3 V (VCCIO1..4 on +3V3).

IO_LOC "mii_txd[0]" G14;
IO_LOC "mii_txd[1]" F14;
IO_LOC "mii_txd[2]" E14;
IO_LOC "mii_txd[3]" D14;
IO_LOC "mii_tx_en"  H14;
IO_LOC "mii_tx_clk" J14;
IO_LOC "mii_col"    C14;
IO_LOC "mii_crs"    P14;
IO_LOC "mii_rxd[0]" P13;
IO_LOC "mii_rxd[1]" P11;
IO_LOC "mii_rxd[2]" P9;
IO_LOC "mii_rxd[3]" P8;
IO_LOC "mii_rx_dv"  P10;
IO_LOC "mii_rx_clk" P12;
IO_LOC "fpga_link"  P1;

IO_PORT "mii_txd[0]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "mii_txd[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "mii_txd[2]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "mii_txd[3]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "mii_tx_en"  IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "mii_tx_clk" IO_TYPE=LVCMOS33;
IO_PORT "mii_col"    IO_TYPE=LVCMOS33;
IO_PORT "mii_crs"    IO_TYPE=LVCMOS33;
IO_PORT "mii_rxd[0]" IO_TYPE=LVCMOS33;
IO_PORT "mii_rxd[1]" IO_TYPE=LVCMOS33;
IO_PORT "mii_rxd[2]" IO_TYPE=LVCMOS33;
IO_PORT "mii_rxd[3]" IO_TYPE=LVCMOS33;
IO_PORT "mii_rx_dv"  IO_TYPE=LVCMOS33;
IO_PORT "mii_rx_clk" IO_TYPE=LVCMOS33;
IO_PORT "fpga_link"  IO_TYPE=LVCMOS33 DRIVE=4;
